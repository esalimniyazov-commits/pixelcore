# Existing Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_ID=

# Telegram Business integration
# Set "*" to allow all customer private chats of the verified Business account,
# or comma-separated Telegram chat IDs for a strict allow-list. Never include owner's own chat.
TELEGRAM_BUSINESS_ALLOWED_CHAT_IDS=
# 0 = greet only once ever; e.g. 30 = greet again after 30 days
TELEGRAM_BUSINESS_GREETING_DAYS=0

# Existing Firestore service account JSON (server-side only)
FIREBASE_SERVICE_ACCOUNT=
