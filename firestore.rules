rules_version = '2';
// PixelCore Studio 2.0 — Firestore Security Rules
// Admin: tasdiqlangan email ro'yxatda bo'lishi shart. Ro'yxatni (ADMIN_EMAIL) o'zingiznikiga almashtiring.
// Foydalanuvchi o'zining admin huquqini hech qanday yo'l bilan oshira olmaydi: admin faqat shu fayldagi email orqali aniqlanadi.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['esalimniyazov@gmail.com'];
    }
    function userRef() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function banned() { return exists(userRef()) && get(userRef()).data.get('banned', false) == true; }
    function okText(v, max) { return v is string && v.size() >= 1 && v.size() <= max; }
    function mine() { return signedIn() && request.resource.data.uid == request.auth.uid && !banned(); }

    // ---------- O'yinlar: hamma o'qiydi; admin yozadi; boshqalar faqat yuklashlar sonini +1 qiladi ----------
    match /games/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads'])
        && request.resource.data.get('downloads', 0) == resource.data.get('downloads', 0) + 1);
    }
    match /news/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /images/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /roadmap/{id} { allow read: if true; allow write: if isAdmin(); }
    match /team/{id}    { allow read: if true; allow write: if isAdmin(); }

    // ---------- Sharhlar (mavjud tuzilma saqlandi) ----------
    match /reviews/{rid} {
      allow read: if true;
      allow create, update: if mine()
        && rid == request.resource.data.gameId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['gameId', 'uid', 'name', 'stars', 'text', 'created'])
        && okText(request.resource.data.name, 20)
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 500;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- Izohlar (yangiliklar uchun) ----------
    match /comments/{id} {
      allow read: if true;
      allow create: if mine()
        && request.resource.data.keys().hasOnly(['targetType', 'targetId', 'uid', 'name', 'text', 'created'])
        && request.resource.data.targetType in ['news', 'game']
        && okText(request.resource.data.targetId, 60)
        && okText(request.resource.data.name, 20)
        && okText(request.resource.data.text, 500);
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- Xatolik / taklif / savol (mavjud "feedback" kolleksiyasi) ----------
    match /feedback/{id} {
      allow create: if mine()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'type', 'text', 'created', 'gameId'])
        && request.resource.data.email == request.auth.token.email
        && okText(request.resource.data.type, 20)
        && okText(request.resource.data.text, 1000);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ---------- Aloqa formasi: hisobsiz ham yuborish mumkin, faqat admin o'qiydi ----------
    match /contacts/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'lang', 'created', 'uid'])
        && okText(request.resource.data.name, 80)
        && okText(request.resource.data.email, 120) && request.resource.data.email.matches('.+@.+')
        && okText(request.resource.data.message, 2000)
        && request.resource.data.created == request.time
        && (!('uid' in request.resource.data) || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow read, delete: if isAdmin();
    }

    // ---------- Foydalanuvchi profili (PixelCore ID) ----------
    match /users/{uid} {
      function validProfile(d) {
        return d.keys().hasOnly(['email', 'favs', 'username', 'avatar', 'created'])
          && (!('email' in d) || (d.email is string && d.email == request.auth.token.email))
          && (!('username' in d) || (d.username is string && d.username.size() >= 3 && d.username.size() <= 20))
          && (!('favs' in d) || (d.favs is list && d.favs.size() <= 200))
          && (!('avatar' in d) || (d.avatar is string && d.avatar.size() <= 10));
      }
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data);
      // bloklangan ('banned') foydalanuvchi o'z profilini o'zgartira/o'chira olmaydi; 'banned' maydonini faqat admin yozadi
      allow update: if (signedIn() && request.auth.uid == uid && !resource.data.get('banned', false) && validProfile(request.resource.data)) || isAdmin();
      allow delete: if (signedIn() && request.auth.uid == uid && !resource.data.get('banned', false)) || isAdmin();
    }

    // ---------- Sayt statistikasi: tashriflar sonini faqat +1 qilish mumkin, o'qish faqat admin ----------
    match /stats/site {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['views']) && request.resource.data.views == 1;
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views == resource.data.views + 1);
    }

    // ---------- Admin faoliyat tarixi ----------
    match /activity/{id} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['admin', 'action', 'target', 'created']);
    }

    // ---------- Eski "scores" kolleksiyasi (mavjud ma'lumotlar saqlanadi) ----------
    match /scores/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 150;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.score is int && request.resource.data.score > resource.data.score && request.resource.data.score <= 150;
    }
  }
}
